</nav>

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <div class="badge-neuro">Neuroinnova Chile SpA</div>
        <h1>Si tu negocio crece, pero no al nivel que te gustaría...</h1>
