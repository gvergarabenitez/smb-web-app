<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Smart Mentor Bot — Demo</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root {
      --smb-dark: #12193a;
      --smb-gold: #c9a227;
      --smb-sidebar: #f7f7f8;
      --smb-border: #e5e5e5;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Söhne', ui-sans-serif, system-ui, -apple-system, sans-serif; background: #fff; height: 100vh; display: flex; flex-direction: column; }

    /* TOP BAR */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.75rem 1.5rem;
      border-bottom: 1px solid var(--smb-border);
      background: #fff;
      flex-shrink: 0;
    }
    .topbar-left { display: flex; align-items: center; gap: 0.75rem; }
    .topbar-logo { height: 32px; }
    .topbar-title { font-size: 0.95rem; font-weight: 600; color: var(--smb-dark); }
    .topbar-subtitle { font-size: 0.78rem; color: #888; }
    .demo-badge {
      background: var(--smb-gold);
      color: var(--smb-dark);
      font-size: 0.7rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: 20px;
      letter-spacing: 0.5px;
    }

    /* CHAT AREA */
    .chat-area {
      flex: 1;
      overflow-y: auto;
      padding: 2rem 0;
    }
    .message-row {
      padding: 0.75rem 1rem;
      display: flex;
      justify-content: center;
    }
    .message-row.user { background: #fff; }
    .message-row.assistant { background: var(--smb-sidebar); }
    .message-inner {
      width: 100%;
      max-width: 720px;
      display: flex;
      gap: 1rem;
      align-items: flex-start;
    }
    .msg-avatar {
      width: 30px;
      height: 30px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .msg-avatar.user-av { background: var(--smb-dark); color: #fff; font-weight: 700; font-size: 0.75rem; }
    .msg-avatar.bot-av { background: var(--smb-gold); color: var(--smb-dark); }
    .msg-content {
      flex: 1;
      font-size: 0.95rem;
      line-height: 1.65;
      color: #1a1a1a;
      padding-top: 3px;
    }
    .msg-content p { margin: 0 0 0.5rem; }
    .msg-content p:last-child { margin-bottom: 0; }

    /* TYPING */
    .typing-dots span {
      display: inline-block;
      width: 6px; height: 6px;
      border-radius: 50%;
      background: #aaa;
      margin: 0 2px;
      animation: bounce 1.2s infinite;
    }
    .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
    .typing-dots span:nth-child(3) { animation-delay: 0.4s; }
    @keyframes bounce {
      0%, 60%, 100% { transform: translateY(0); }
      30% { transform: translateY(-5px); }
    }

    /* INPUT AREA */
    .input-area {
      border-top: 1px solid var(--smb-border);
      padding: 1rem 1rem 1.5rem;
      background: #fff;
      flex-shrink: 0;
    }
    .input-inner {
      max-width: 720px;
      margin: 0 auto;
    }
    .counter-bar {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 0.6rem;
      font-size: 0.78rem;
      color: #999;
    }
    .dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      background: #ddd;
      transition: background 0.3s;
    }
    .dot.used { background: var(--smb-gold); }
    .input-box {
      display: flex;
      align-items: flex-end;
      gap: 0.5rem;
      border: 1px solid var(--smb-border);
      border-radius: 12px;
      padding: 0.6rem 0.75rem;
      background: #fff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .input-box:focus-within { border-color: var(--smb-gold); box-shadow: 0 0 0 3px rgba(201,162,39,0.1); }
    #userInput {
      flex: 1;
      border: none;
      outline: none;
      resize: none;
      font-size: 0.95rem;
      line-height: 1.5;
      max-height: 160px;
      font-family: inherit;
      background: transparent;
      color: #1a1a1a;
    }
    #sendBtn {
      background: var(--smb-dark);
      border: none;
      border-radius: 8px;
      width: 34px; height: 34px;
      display: flex; align-items: center; justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      transition: background 0.2s;
    }
    #sendBtn:hover { background: #1e2a5a; }
    #sendBtn:disabled { background: #ccc; cursor: not-allowed; }
    #sendBtn svg { width: 16px; height: 16px; fill: #fff; }
    .hint { font-size: 0.75rem; color: #bbb; text-align: center; margin-top: 0.5rem; }

    /* CTA */
    .cta-area {
      display: none;
      background: #fff;
      border-top: 1px solid var(--smb-border);
      padding: 2rem 1rem;
      text-align: center;
      flex-shrink: 0;
    }
    .cta-inner { max-width: 560px; margin: 0 auto; }
    .cta-inner h5 { font-size: 1.15rem; font-weight: 700; color: var(--smb-dark); margin-bottom: 0.5rem; }
    .cta-inner p { color: #666; font-size: 0.92rem; margin-bottom: 1.25rem; line-height: 1.55; }
    .btn-primary-smb {
      background: var(--smb-gold);
      color: var(--smb-dark);
      font-weight: 700;
      padding: 0.7rem 1.75rem;
      border-radius: 8px;
      border: none;
      font-size: 0.95rem;
      text-decoration: none;
      display: inline-block;
      margin: 0.25rem;
      transition: all 0.2s;
    }
    .btn-primary-smb:hover { background: #e8c547; color: var(--smb-dark); }
    .btn-secondary-smb {
      background: transparent;
      color: #666;
      font-weight: 500;
      padding: 0.7rem 1.5rem;
      border-radius: 8px;
      border: 1px solid var(--smb-border);
      font-size: 0.92rem;
      text-decoration: none;
      display: inline-block;
      margin: 0.25rem;
      transition: all 0.2s;
    }
    .btn-secondary-smb:hover { border-color: #aaa; color: #333; }
  </style>
</head>
<body>

<!-- TOP BAR -->
<div class="topbar">
  <div class="topbar-left">
    <img src="/logo.png" class="topbar-logo" alt="SMB">
    <div>
      <div class="topbar-title">Smart Mentor Bot</div>
      <div class="topbar-subtitle">Demo personalizado para <%= demo.empresa.substring(0, 40) %><%= demo.empresa.length > 40 ? '…' : '' %></div>
    </div>
  </div>
  <span class="demo-badge">DEMO GRATUITO</span>
</div>

<!-- MESSAGES -->
<div class="chat-area" id="chatArea">

  <div class="message-row assistant">
    <div class="message-inner">
      <div class="msg-avatar bot-av">🧠</div>
      <div class="msg-content">
        Hola, soy tu Smart Mentor Bot. Analicé el perfil de tu empresa y estoy listo para trabajar contigo.<br><br>
        Tienes <strong>5 consultas disponibles</strong> en este demo. Pregúntame sobre estrategia, ventas, clientes, propuestas, diferenciación, o cualquier desafío que estés enfrentando ahora mismo.
      </div>
    </div>
  </div>

  <div class="message-row assistant" id="typingRow" style="display:none;">
    <div class="message-inner">
      <div class="msg-avatar bot-av">🧠</div>
      <div class="msg-content">
        <div class="typing-dots"><span></span><span></span><span></span></div>
      </div>
    </div>
  </div>

</div>

<!-- INPUT -->
<div class="input-area" id="inputArea">
  <div class="input-inner">
    <div class="counter-bar">
      <% for(let i = 0; i < 5; i++) { %><div class="dot" id="dot-<%= i %>"></div><% } %>
      <span id="counterText">0 de 5 consultas usadas</span>
    </div>
    <div class="input-box">
      <textarea id="userInput" rows="1" placeholder="Escribe tu consulta aquí…"></textarea>
      <button id="sendBtn" title="Enviar">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
      </button>
    </div>
    <div class="hint">Enter para enviar · Shift+Enter para nueva línea</div>
  </div>
</div>

<!-- CTA -->
<div class="cta-area" id="ctaArea">
  <div class="cta-inner">
    <h5>¿Quieres que tu Smart Mentor Bot esté disponible siempre?</h5>
    <p>Acabas de ver el demo. El producto completo conoce toda tu empresa en profundidad, ejecuta acciones y está disponible 24/7 para cualquier decisión de negocio.</p>
    <a href="/onboarding" class="btn-primary-smb">Quiero mi Smart Mentor Bot →</a>
    <a href="/demo" class="btn-secondary-smb">Volver a empezar</a>
  </div>
</div>

<script>
  const sessionId = '<%= sessionId %>';
  let count = 0;
  const max = 5;

  const chatArea = document.getElementById('chatArea');
  const typingRow = document.getElementById('typingRow');
  const input = document.getElementById('userInput');
  const sendBtn = document.getElementById('sendBtn');
  const inputArea = document.getElementById('inputArea');
  const ctaArea = document.getElementById('ctaArea');
  const counterText = document.getElementById('counterText');

  // Auto-resize textarea
  input.addEventListener('input', () => {
    input.style.height = 'auto';
    input.style.height = Math.min(input.scrollHeight, 160) + 'px';
  });

  function updateCounter() {
    counterText.textContent = `${count} de ${max} consultas usadas`;
    for (let i = 0; i < max; i++) {
      document.getElementById(`dot-${i}`).classList.toggle('used', i < count);
    }
  }

  function addMessage(text, role) {
    const row = document.createElement('div');
    row.className = `message-row ${role === 'user' ? 'user' : 'assistant'}`;
    const avatar = role === 'user'
      ? `<div class="msg-avatar user-av">Tú</div>`
      : `<div class="msg-avatar bot-av">🧠</div>`;
    const formatted = text.replace(/\n/g, '<br>');
    row.innerHTML = `<div class="message-inner">${avatar}<div class="msg-content">${formatted}</div></div>`;
    chatArea.insertBefore(row, typingRow);
    chatArea.scrollTop = chatArea.scrollHeight;
  }

  async function send() {
    const msg = input.value.trim();
    if (!msg || count >= max) return;

    input.value = '';
    input.style.height = 'auto';
    input.disabled = true;
    sendBtn.disabled = true;
    addMessage(msg, 'user');

    typingRow.style.display = 'flex';
    chatArea.scrollTop = chatArea.scrollHeight;

    try {
      const res = await fetch(`/demo/chat/${sessionId}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ mensaje: msg })
      });
      const data = await res.json();
      typingRow.style.display = 'none';

      if (data.error) {
        addMessage('Ocurrió un error. Por favor intenta de nuevo.', 'assistant');
      } else {
        addMessage(data.reply, 'assistant');
        count = data.count;
        updateCounter();
        if (count >= max) {
          inputArea.style.display = 'none';
          ctaArea.style.display = 'block';
        }
      }
    } catch (e) {
      typingRow.style.display = 'none';
      addMessage('Error de conexión. Por favor intenta de nuevo.', 'assistant');
    }

    input.disabled = false;
    sendBtn.disabled = false;
    input.focus();
  }

  sendBtn.addEventListener('click', send);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); send(); }
  });
</script>
</body>
</html>
