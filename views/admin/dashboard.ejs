<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Dashboard Admin — Smart Mentor Bot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body style="background:#f4f6f8;">

<nav class="navbar navbar-smb">
  <div class="container-fluid px-4">
    <span class="navbar-brand text-white fw-bold">SMB Admin</span>
    <a href="/admin/logout" class="btn btn-outline-light btn-sm">Cerrar sesión</a>
  </div>
</nav>

<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="fw-bold mb-0">Formularios recibidos</h4>
      <p class="text-muted small mb-0"><%= submissions.length %> cliente(s) en total</p>
    </div>
  </div>

  <% if (submissions.length === 0) { %>
    <div class="alert alert-light border text-center py-5">
      <p class="mb-0 text-muted">Aún no hay formularios enviados.</p>
    </div>
  <% } else { %>
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Empresa</th>
            <th>Email</th>
            <th>Plan</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% submissions.forEach(s => { %>
          <tr>
            <td class="fw-semibold"><%= s.datos.nombre_empresa || '—' %></td>
            <td class="text-muted small"><%= s.datos.email_contacto || '—' %></td>
            <td><span class="badge bg-secondary"><%= s.datos.plan || '—' %></span></td>
            <td class="text-muted small"><%= new Date(s.fecha).toLocaleDateString('es-CL', {day:'2-digit',month:'short',year:'numeric'}) %></td>
            <td>
              <span class="badge badge-estado-<%= s.estado %>"><%= s.estado %></span>
            </td>
            <td>
              <a href="/admin/cliente/<%= s.id %>" class="btn btn-sm btn-outline-secondary">Ver →</a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
