<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin — Smart Mentor Bot</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body style="background:#f4f6f8;">
  <div class="min-vh-100 d-flex align-items-center justify-content-center">
    <div style="width:380px;">
      <div class="text-center mb-4">
        <div style="font-size:2.5rem;">🔐</div>
        <h4 class="fw-bold mt-2">Panel Admin</h4>
        <p class="text-muted small">Smart Mentor Bot — Neuroinnova Chile SpA</p>
      </div>
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <% if (error) { %>
            <div class="alert alert-danger small"><%= error %></div>
          <% } %>
          <form method="POST" action="/admin/login">
            <div class="mb-3">
              <label class="form-label fw-semibold">Contraseña</label>
              <input type="password" name="password" class="form-control" autofocus required>
            </div>
            <button type="submit" class="btn btn-smb w-100">Ingresar</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
