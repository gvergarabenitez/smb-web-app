<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= cliente.datos.nombre_empresa %> — Admin SMB</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body style="background:#f4f6f8;">

<nav class="navbar navbar-smb">
  <div class="container-fluid px-4">
    <span class="navbar-brand text-white fw-bold">SMB Admin</span>
    <div class="d-flex gap-2">
      <a href="/admin" class="btn btn-outline-light btn-sm">← Volver</a>
      <a href="/admin/logout" class="btn btn-outline-light btn-sm">Cerrar sesión</a>
    </div>
  </div>
</nav>

<div class="container py-4" style="max-width:900px;">

  <!-- Header -->
  <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
      <h4 class="fw-bold mb-1"><%= cliente.datos.nombre_empresa %></h4>
      <p class="text-muted small mb-0">ID: <%= cliente.id %> · Enviado: <%= new Date(cliente.fecha).toLocaleString('es-CL') %></p>
    </div>
    <form method="POST" action="/admin/cliente/<%= cliente.id %>/estado" class="d-flex gap-2 align-items-center">
      <select name="estado" class="form-select form-select-sm" style="width:auto;">
        <option value="pendiente" <%- cliente.estado === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
        <option value="en-proceso" <%- cliente.estado === 'en-proceso' ? 'selected' : '' %>>En proceso</option>
        <option value="activo" <%- cliente.estado === 'activo' ? 'selected' : '' %>>SMB Activo</option>
      </select>
      <button type="submit" class="btn btn-smb btn-sm">Guardar estado</button>
    </form>
  </div>

  <%
  const secciones = [
    { titulo: '1. Información General', campos: [
      ['Empresa', 'nombre_empresa'], ['RUT Empresa', 'rut_empresa'],
      ['Representante Legal', 'nombre_representante'], ['RUT Representante', 'rut_representante'],
      ['Dirección', 'direccion'], ['Giro', 'giro'],
      ['Sector', 'sector'], ['Ubicación', 'ubicacion'],
      ['Año Fundación', 'año_fundacion'], ['Web', 'web'],
      ['Email contacto', 'email_contacto'], ['Redes Sociales', 'redes_sociales'],
      ['Misión', 'mision'], ['Visión', 'vision'],
      ['Descripción del negocio', 'descripcion_negocio'],
      ['Productos/Servicios', 'productos_servicios'], ['Organigrama', 'organigrama'],
    ]},
    { titulo: '2. Objetivos y Desafíos', campos: [
      ['Objetivos 6-12 meses', 'objetivos'], ['Problemáticas', 'problematicas'],
      ['Desafíos actuales', 'desafios'], ['KPIs', 'kpis'],
    ]},
    { titulo: '3. Clientes y Mercado', campos: [
      ['Cliente ideal', 'cliente_ideal'], ['Segmentos de clientes', 'segmentos_clientes'],
      ['Dolores que resuelves', 'dolores_clientes'], ['Feedback de clientes', 'feedback_clientes'],
    ]},
    { titulo: '4. Estrategia Comercial', campos: [
      ['Estrategias comerciales', 'estrategias_comerciales'],
      ['Procesos internos', 'procesos_internos'], ['Herramientas digitales', 'herramientas'],
    ]},
    { titulo: '5. Preguntas Frecuentes', campos: [
      ['Preguntas frecuentes', 'preguntas_frecuentes'],
      ['Problemas recurrentes', 'problemas_recurrentes'],
      ['Escenarios de uso del SMB', 'escenarios_smb'],
    ]},
    { titulo: '6. Expectativas', campos: [
      ['Expectativas del SMB', 'expectativas'], ['Criterios de éxito', 'criterios_exito'],
      ['Proyecciones', 'proyecciones'], ['Observaciones', 'observaciones'],
    ]},
    { titulo: '7. Plan', campos: [['Plan seleccionado', 'plan']] },
  ];
  %>

  <% secciones.forEach(sec => { %>
  <div class="form-section mb-3">
    <h4><%= sec.titulo %></h4>
    <% sec.campos.forEach(([label, key]) => { %>
      <% if (cliente.datos[key]) { %>
      <div class="mb-3">
        <p class="form-label mb-1"><%= label %></p>
        <p class="text-muted small mb-0" style="white-space:pre-wrap;"><%= cliente.datos[key] %></p>
      </div>
      <% } %>
    <% }) %>
  </div>
  <% }) %>

  <!-- Archivos -->
  <% const tieneArchivos = Object.keys(cliente.archivos || {}).length > 0; %>
  <% if (tieneArchivos) { %>
  <div class="form-section mb-3">
    <h4>Archivos adjuntos</h4>
    <% for (const [campo, archivos] of Object.entries(cliente.archivos)) { %>
      <% archivos.forEach(arch => { %>
      <div class="d-flex align-items-center gap-2 mb-2">
        <span class="text-muted small">📎</span>
        <a href="/admin/cliente/<%= cliente.id %>/archivo/<%= campo %>/<%= arch.ruta %>" class="small">
          <%= arch.nombre %>
        </a>
      </div>
      <% }) %>
    <% } %>
  </div>
  <% } %>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
